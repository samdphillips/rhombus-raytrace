#lang rhombus/static

import:
  "material_fwd.rhm"
  "interval.rhm" open
  "ray.rhm" open
  "vec3.rhm":
    expose Vec3

export:
  Surface
  Hit

class Hit(p :: Vec3,
          normal :: Vec3,
          material :: material_fwd.MaterialFwd,
          t :: Real,
          front_face :: Boolean)

interface Surface:
  method hit(r :: Ray, ray_t :: Interval) :~ maybe(Hit)
