#lang rhombus/static

import:
  draw:
    expose Bitmap
  rhombus/flonum
  "interval.rhm" open
  "ray.rhm" open
  "scene.rhm" open
  "surface.rhm" open
  "vec3.rhm" open

export:
  Camera

def MAX_CVAL = 255.999

fun to_comp(v :~ Flonum):
  flonum.to_int(flonum.floor(v))

class Camera(~aspect_ratio: aspect_ratio :: Real = 1.0,
             ~image_width: image_width :: PosInt = 100):
  method render(scene :: Scene) :~ Bitmap:
    // Initialize additional render parameters
    def image_height:
      let image_height = math.floor(image_width / aspect_ratio)
      if image_height < 1 | 1 | image_height
    def center = Vec3.origin
    def values(px_du :~ Vec3, px_dv :~ Vec3, px00_loc :~ Vec3):
      def focal_length = 1.0
      def viewport_height = 2.0
      def viewport_width = viewport_height * (0.0 + image_width) / image_height
      def viewport_u = Vec3(viewport_width, 0, 0)
      def viewport_v = Vec3(0, -viewport_height, 0)
      def px_du = viewport_u / image_width
      def px_dv = viewport_v / image_height
      def viewport_ul:
        center - Vec3(0, 0, focal_length) - viewport_u / 2 - viewport_v / 2
      def px00_loc:
        viewport_ul + (px_du + px_dv) / 2
      values(px_du, px_dv, px00_loc)

    def pixels:
      Bytes.make(image_width * image_height * 4)

    // Render loop
    for:
      each j: 0..image_height
      print(".")
      when j mod 10 == 0 | print(j)
      each i: 0..image_width
      def px_c = px00_loc + i * px_du + j * px_dv
      def ray_v = px_c - center
      def ray = Ray(center, ray_v)
      def values(r, g, b) = ray_color(ray, scene)

      def o = (j * image_width + i) * 4
      pixels[o + 0] := 255
      pixels[o + 1] := r
      pixels[o + 2] := g
      pixels[o + 3] := b

    def bm = Bitmap([image_width, image_height])
    bm.set_argb_pixels(pixels)
    bm

  private method ray_color(r :~ Ray, s :~ Surface) :~ values(Byte, Byte, Byte):
    def c :~ Vec3:
      match s.hit(r, Interval(0, #inf))
      | Hit(_, normal, _, _):
          (normal + Vec3(1, 1, 1)) / 2 * MAX_CVAL
      | ~else:
          def unit = r.dir.unit()
          def a = (unit.y + 1) / 2
          def c0 = 1 - a
          def v0 = Vec3(c0, c0, c0)
          def v1 = Vec3(0.5, 0.7, 1.0) * a
          (v0 + v1) * MAX_CVAL
    values(to_comp(c.x),
           to_comp(c.y),
           to_comp(c.z))