#lang rhombus/static

import:
  "camera.rhm" open
  "scene.rhm" open
  "sphere.rhm" open
  "vec3.rhm" open

def scene:
  Scene.build:
    Sphere(Vec3(0, 0, -1), 0.5)
    Sphere(Vec3(0, -100.5, -1), 100)

def camera = Camera(~aspect_ratio: 16/9,
                    ~image_width: 400,
                    ~samples_per_pixel: 100,
                    ~max_depth: 50)

camera.render(scene)
