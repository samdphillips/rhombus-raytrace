#lang rhombus/static/and_meta

import:
  lib("racket/base.rkt"):
    only #{box-cas!}
    rename #{box-cas!} as box_cas
    expose box_cas

export:
  rename make_counter as Counter
  except_space expr: Counter

veneer Counter(this :~ MutableBox):
  private method compare_and_set(old, new) :~ Boolean:
    box_cas(this, old, new)

  method next() :~ Nat:
    let v = this.value
    if compare_and_set(v, v + 1)
    | v
    | next()

fun make_counter() :~ Counter:
  Box(0)
